# Copie para .env.local (desenvolvimento) e preencha.
# Em produção, cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).

# ── Supabase (Project Settings → API) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública "anon" (vai para o navegador; a segurança vem das políticas RLS)
NEXT_PUBLIC_SUPABASE_ANON=
# Chave "service_role" — SECRETA, só no servidor. Ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=
# (Nome antigo, aceito durante a transição. Pode ser removido quando a de cima existir.)
# SUPABASE_SERVICE_ROLE=

# ── Endereço público do sistema (só a origem, sem /fest) ───────────────────
NEXT_PUBLIC_APP_URL=https://www.arxum.com.br

# ── Resend (e-mails de convite, vínculo e autorização) ─────────────────────
RESEND_API_KEY=
# Opcional. Padrão: "ARXUM Fest <noreply@csstudios.site>"
RESEND_FROM=

# ── UploadThing (áudios, mapas de luz e imagens) ───────────────────────────
UPLOADTHING_TOKEN=
